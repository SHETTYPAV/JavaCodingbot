class A6
{
	public static void main(String[]args)
	{
		float[]arr={10,20,30,40};
		System.out.println("*******************");
		System.out.println("index \tvalues");
		System.out.println("*******************");
		for(int i=0;i<arr.length;i++)
		{
			System.out.println(i+" \t"+arr[i]);
		}
}
}