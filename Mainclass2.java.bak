abstract class Sample2
{
	 abstract void cool();
	 abstract void fo();
}
abstract class Demo2 extends Sample2
{
	void cool()
	{
		System.out.println("i am cool");
	}
}
class cool2 extends Demo2
{
	void fo()
	{
		System.out.println("i am fo");
	}
}

class Mainclass
{
	public static void main(String[]args)
	{
		cool2 d1=new cool2();
		d1.cool();
	    d1.fo();
}
}
